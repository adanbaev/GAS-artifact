        <mxCell id="common" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;Common UPDATE evidence path&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#EAF5EC;strokeColor=#3A8F55;strokeWidth=2.6;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="25" y="350" width="1250" height="410" as="geometry" />
        </mxCell>
        <mxCell id="tx" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;&lt;b&gt;logUpdateById(freq_id): public, proxy-invoked @Transactional&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;All InnoDB writes of the selected evidence strategy share this transaction&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#DCEFE1;strokeColor=#3A8F55;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="55" y="393" width="1190" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;b&gt;4. Fresh DB re-read&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;freq + site + owner&lt;br&gt;one LEFT JOIN by freq_id&lt;br&gt;direct JDBC connection&lt;br&gt;not transaction-bound&lt;br&gt;persisted state&lt;br&gt;not form input&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#3A8F55;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="55" y="480" width="310" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;b&gt;5. Event context&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;action = UPDATE&lt;br&gt;event_ms&lt;br&gt;actor or SYSTEM&lt;br&gt;INSERT is outside&lt;br&gt;the evaluated scope&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#3A8F55;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="385" y="480" width="220" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;b&gt;6. Canonical input D_i&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;23 protected fields&lt;br&gt;4 owner + 7 site + 12 freq&lt;br&gt;fixed order&lt;br&gt;each value: len(v):v;&lt;br&gt;null / missing -&amp;gt; empty&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#3A8F55;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="625" y="480" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;b&gt;7. HMAC evidence&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;data_hash = HMAC-SHA-256&lt;br&gt;key: S_secret&lt;br&gt;message: D_i&lt;br&gt;64 lowercase hex characters&lt;br&gt;freshly re-read state is hashed&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#3A8F55;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="925" y="480" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;&lt;b&gt;Missing/invalid row -&amp;gt; return; SQLException -&amp;gt; stdout + return.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;The MyISAM UPDATE remains committed; no evidence row is written.&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFF7E6;strokeColor=#D97904;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="55" y="690" width="1190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="route" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;b&gt;8. Route by configured Strategy&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;FINGERPRINT &amp;lt;- HMAC_ONLY&lt;br&gt;CHECKPOINT &amp;lt;- HMAC_CHECKPOINT&lt;br&gt;STRICT &amp;lt;- HMAC_STRICT&lt;br&gt;Configured S_secret and S_chain come from env/properties, never from the database&lt;br&gt;Both secrets are required; startup fails if either is absent, blank, or set to a documented placeholder.&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#F4F4F4;strokeColor=#777777;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="25" y="785" width="1250" height="145" as="geometry" />
        </mxCell>
        <mxCell id="finger" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;FINGERPRINT&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;unchained&lt;br&gt;per write&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFF2E5;strokeColor=#D97904;strokeWidth=2.6;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="25" y="960" width="280" height="570" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 19.5px&quot;&gt;&lt;b&gt;9A. Persist one&lt;br&gt;event row&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;freq_integrity_event&lt;br&gt;event metadata&lt;br&gt;+ data_hash&lt;br&gt;InnoDB&lt;br&gt;no cryptographic link&lt;br&gt;to preceding rows&lt;br&gt;commit / return&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#D97904;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="39" y="1052" width="252" height="280" as="geometry" />
        </mxCell>
        <mxCell id="checkpoint" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;CHECKPOINT&lt;br&gt;volatile batch + periodic chained checkpoint&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#EAF3F8;strokeColor=#3E6B8F;strokeWidth=2.6;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="330" y="960" width="610" height="570" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 19.5px&quot;&gt;&lt;b&gt;9B. Append under checkpointLock&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;pending_root starts at BATCH_GENESIS&lt;br&gt;root&amp;#x27; = SHA-256(root | event_ms | actor | action |&lt;br&gt;freq_id | data_hash | S_chain); pending_count++&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#3E6B8F;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="355" y="1052" width="560" height="135" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;&lt;b&gt;pending_count&lt;br&gt;&amp;gt;= K?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFF4D6;strokeColor=#C89B2B;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rhombus;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="365" y="1197" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c_return" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;&lt;b&gt;Return&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;batch stays&lt;br&gt;in JVM&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#3E6B8F;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="1212" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;&lt;b&gt;Flush in the same evidence transaction&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;batch INSERT; end_id = max(id)&lt;br&gt;start_id = end_id - count + 1&lt;br&gt;lock integrity_checkpoint_state FOR UPDATE&lt;br&gt;checkpoint_hash = SHA-256(prev | batch_no |&lt;br&gt;start_id | end_id | count | root | S_chain)&lt;br&gt;insert checkpoint + update state&lt;br&gt;reset BATCH_GENESIS; commit / return&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#3E6B8F;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="355" y="1315" width="560" height="195" as="geometry" />
        </mxCell>
        <mxCell id="strict" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;STRICT&lt;br&gt;global chain, per write&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#F0ECF8;strokeColor=#7656A5;strokeWidth=2.6;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="965" y="960" width="310" height="570" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 19.5px&quot;&gt;&lt;b&gt;9C. Lock chain state&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;integrity_chain_state&lt;br&gt;SELECT ... FOR UPDATE&lt;br&gt;prev = GENESIS when&lt;br&gt;last_hash is empty&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#7656A5;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="985" y="1052" width="270" height="135" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 19.5px&quot;&gt;&lt;b&gt;Compute chain_hash&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;chain_hash = SHA-256(&lt;br&gt;prev | event_ms |&lt;br&gt;actor | action |&lt;br&gt;freq_id | data_hash |&lt;br&gt;S_chain)&lt;br&gt;INSERT&lt;br&gt;freq_integrity_log&lt;br&gt;UPDATE&lt;br&gt;integrity_chain_state&lt;br&gt;(last_hash)&lt;br&gt;commit / return&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFFFFF;strokeColor=#7656A5;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="985" y="1207" width="270" height="290" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 19.5px&quot;&gt;&lt;b&gt;Persistence and verification boundaries&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;The MyISAM registry UPDATE is outside InnoDB evidence rollback.&lt;br&gt;An unfinished CHECKPOINT batch is JVM-volatile across restart; DB rollback does not restore it.&lt;br&gt;Evidence remains in the same writable DB: verification shows retained-state consistency only.&lt;br&gt;Freshness/completeness after consistent suffix deletion requires an external anchor.&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#F4F4F4;strokeColor=#777777;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="25" y="1540" width="1250" height="125" as="geometry" />
        </mxCell>
