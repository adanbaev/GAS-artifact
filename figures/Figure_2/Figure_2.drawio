        <mxCell id="e3" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=none;strokeColor=#17232E;strokeWidth=1.5;endSize=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
