        <mxCell id="n36" value="&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;b&gt;11B. K reached?&lt;/b&gt;&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
