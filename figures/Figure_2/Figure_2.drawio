        <mxCell id="n34" value="&lt;font style=&quot;font-size: 12.5px&quot;&gt;&lt;b&gt;B. CHECKPOINT (Buffered + Checkpointed)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#E7F0FA;strokeColor=#5B9BD5;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
