        <mxCell id="n24" value="&lt;font style=&quot;font-size: 11.5px&quot;&gt;&lt;b&gt;5. Fresh DB Re-read&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;Load OwnerModel,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;SiteModel, FreqModel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;by &lt;font face=&quot;Courier New&quot;&gt;freq_id&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#D9EAD3;strokeColor=#6AA84F;" vertex="1" parent="1">
