        <mxCell id="n22" value="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;4. Integrity Service Invocation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;• After UPDATE: via &lt;font face=&quot;Courier New&quot;&gt;FreqCrudService.logUpdateById(freq_id)&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;• After INSERT: from insert path via &lt;font face=&quot;Courier New&quot;&gt;logInsertById(new_freq_id)&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;• Action = UPDATE or INSERT&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#D9EAD3;strokeColor=#6AA84F;align=left;spacingLeft=10;" vertex="1" parent="1">
