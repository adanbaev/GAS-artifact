        <mxCell id="n21" value="&lt;font style=&quot;font-size: 10px&quot;&gt;Operational registry tables use MyISAM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;and are not part of the InnoDB transaction.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#DEEBF7;strokeColor=#5B9BD5;" vertex="1" parent="1">
