        <mxCell id="n23" value="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;Application-Layer Integrity Processing (IntegrityService)&lt;/b&gt;&lt;/font&gt;" style="rounded=0;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=none;strokeColor=#333333;dashed=1;dashPattern=8 6;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
