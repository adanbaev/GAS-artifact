        <mxCell id="n13" value="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;1. Per-request TRBAC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;(&lt;font face=&quot;Courier New&quot;&gt;TrbacPerRequestFilter&lt;/font&gt;)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;• Read current authority&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;• Evaluate trusted server time&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;• Request-scoped downgrade&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;   off-hours&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#BDD7EE;strokeColor=#2E75B6;align=left;spacingLeft=10;" vertex="1" parent="1">
