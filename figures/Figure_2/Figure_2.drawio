          <mxGeometry x="528" y="382" width="162" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size: 11.5px&quot;&gt;&lt;b&gt;7. Canonical Input (23 fields)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;Algorithm 1&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;Length-prefix encoded&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;deterministic string (&lt;font face=&quot;Courier New&quot;&gt;D_i&lt;/font&gt;)&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#D9EAD3;strokeColor=#6AA84F;" vertex="1" parent="1">
          <mxGeometry x="708" y="382" width="172" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size: 11.5px&quot;&gt;&lt;b&gt;8. HMAC Evidence&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;Algorithm 2&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;HMAC-SHA-256(S_secret, D_i)&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;→ &lt;font face=&quot;Courier New&quot;&gt;data_hash&lt;/font&gt; (64 hex chars)&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#D9EAD3;strokeColor=#6AA84F;" vertex="1" parent="1">
          <mxGeometry x="898" y="382" width="177" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size: 10.5px&quot;&gt;&lt;b&gt;Secrets&lt;/b&gt; (external configuration)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;S_secret&lt;/font&gt;   (HMAC key)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;S_chain&lt;/font&gt;   (Chain key)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px&quot;&gt;(Fallback: &lt;font face=&quot;Courier New&quot;&gt;S_chain&lt;/font&gt; = &lt;font face=&quot;Courier New&quot;&gt;S_secret&lt;/font&gt;)&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#E6DCF0;strokeColor=#8E6FB0;" vertex="1" parent="1">
