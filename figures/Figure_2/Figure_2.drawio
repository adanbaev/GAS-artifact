        <mxCell id="n35" value="&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;b&gt;10B. Append to in-memory pending batch&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;Update &lt;font face=&quot;Courier New&quot;&gt;pending_root&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;pending_events&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;pending_count&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;(Synchronized on &lt;font face=&quot;Courier New&quot;&gt;checkpointLock&lt;/font&gt;)&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#5B9BD5;" vertex="1" parent="1">
