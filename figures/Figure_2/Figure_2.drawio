        <mxCell id="n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;b&gt;1. Per-request&lt;br&gt;TRBAC&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;Authenticated request&lt;br&gt;settings + current&lt;br&gt;authority&lt;br&gt;LocalTime.now(zone)&lt;br&gt;off-hours: temporary&lt;br&gt;authority&lt;br&gt;restored in finally&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#EAF3F8;strokeColor=#3E6B8F;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="250" height="220" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;b&gt;2. Successful registry UPDATE&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;Application: owner -&amp;gt; optional site -&amp;gt; freq&lt;br&gt;(site is written only if siteId &amp;gt; 0)&lt;br&gt;Benchmark (all reported timings):&lt;br&gt;updateFreqOnly() -&amp;gt; freq only&lt;br&gt;Legacy signature (benchmark disabled):&lt;br&gt;SHA-256(ownerName + nominal +&lt;br&gt;issueDate + S_secret)&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#EAF3F8;strokeColor=#3E6B8F;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="305" y="20" width="430" height="210" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 19px&quot;&gt;&lt;b&gt;3. Integrity&lt;br&gt;enabled?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FFF4D6;strokeColor=#C89B2B;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rhombus;fontSize=19;" vertex="1" parent="1">
