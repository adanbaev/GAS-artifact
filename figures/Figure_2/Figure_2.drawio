        <mxCell id="n37" value="&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;b&gt;Return;&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;batch retained&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;in memory&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#5B9BD5;" vertex="1" parent="1">
          <mxGeometry x="795" y="700" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;b&gt;12B. Finalize batch&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;• Batch-insert events → &lt;font face=&quot;Courier New&quot;&gt;freq_integrity_event&lt;/font&gt; (InnoDB)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;• Create checkpoint row → &lt;font face=&quot;Courier New&quot;&gt;integrity_checkpoint&lt;/font&gt; (InnoDB)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;• Update &lt;font face=&quot;Courier New&quot;&gt;integrity_checkpoint_state&lt;/font&gt; (InnoDB)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px&quot;&gt;• Reset pending batch state&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#5B9BD5;align=left;spacingLeft=10;" vertex="1" parent="1">
