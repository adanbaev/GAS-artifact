        <mxCell id="n33" value="&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;freq_integrity_event&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;(InnoDB)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FDEBD2;strokeColor=#E08E0B;verticalAlign=middle;" vertex="1" parent="1">
