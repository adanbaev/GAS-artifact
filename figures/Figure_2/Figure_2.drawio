        <mxCell id="end" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;&lt;b&gt;STANDARD -&amp;gt;&lt;br&gt;End&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 18.5px&quot;&gt;IntegrityService&lt;br&gt;disabled&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#FCEAEA;strokeColor=#C64848;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18.5;" vertex="1" parent="1">
          <mxGeometry x="1035" y="70" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="diagnostic" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size: 19.5px&quot;&gt;&lt;b&gt;HMAC_COMPUTE&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;from STANDARD/End; integrity off&lt;br&gt;re-read + HMAC: steps 4, 6, 7&lt;br&gt;freqDao.getById() +&lt;br&gt;SecurityUtil.freqDataHash()&lt;br&gt;no evidence persistence&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#17232E;fillColor=#F4F4F4;strokeColor=#777777;strokeWidth=2.2;align=center;verticalAlign=middle;spacing=14;spacingLeft=14;spacingRight=14;rounded=1;arcSize=8;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="930" y="199" width="345" height="142" as="geometry" />
